# Postgres connection string. On Neon, use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docs"

# Used to HMAC-sign the session cookie. Any long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: separate DB for integration tests (tests that need it are skipped if unset)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docs_test"
